{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning"
            }
        },
        "Enrich": [
            "FromLogContext"
        ],
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/orderservice-log-.txt",
                    "rollingInterval": "Day",
                    "shared": true
                }
            },
            {
                "Name": "Seq",
                "Args": {
                    "serverUrl": "http://seq:80"
                }
            },
            {
                "Name": "Elasticsearch",
                "Args": {
                    "nodeUris": "http://elasticsearch:9200"
                }
            }
        ]
    },
    "MongoSettings": {
        "ConnectionString": "mongodb://mongodb:27017",
        "DatabaseName": "OrderServiceDb"
    },
    "PostgresSettings": {
        "ConnectionString": "Host=orderdb;Port=5432;Username=postgres;Password=postgres;Database=orderdb"
    },
    "RabbitMq": {
        "Host": "rabbitmq",
        "Username": "guest",
        "Password": "guest",
        "VirtualHost": "/"
    },
    "ElasticConfiguration": {
        "Uri": "http://elasticsearch:9200"
    },
    "SeqConfiguration": {
        "Uri": "http://seq:80"
    },
    "OpenTelemetry": {
        "JaegerEndpoint": "http://jaeger:4317"
    },
    "EventDelivery": {
        "Strategy": "outbox"
    },
    "AllowedHosts": "*"
}